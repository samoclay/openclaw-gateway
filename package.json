{
  "name": "halcyon-openclaw",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w portal",
    "build": "npm run build -w portal",
    "test": "npm run test --workspaces --if-present",
    "bootstrap-admin": "npm run bootstrap-admin -w portal"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "overrides": {
    "postcss": "8.5.28",
    "vitest": "5.0.0",
    "@vitest/mocker": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
