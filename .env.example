AUTH_SECRET=replace-with-32-plus-random-chars
AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme-admin

# DynamoDB Local (docker compose) or AWS
AWS_REGION=eu-west-2
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_TABLE_PREFIX=halcyon_

# OpenClaw Gateway on the Mac Studio (loopback or Tailscale). Never public.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-gateway-token

OPENCLAW_BIN=openclaw
OPENCLAW_CONFIG_PATH=
OPENCLAW_WORKSPACE_ROOT=
OPENCLAW_PROVISION_CMD=
